rules_version = '2';

// ============================================================================
// Test Nest — Cloud Firestore Production Security Rules
// ============================================================================
// - Multiple teachers operate independently; cross-teacher access is blocked.
// - Students authenticate via Firebase Authentication (email/password).
// - Reusable joining codes are validated and managed with proper ownership.
// - Join requests are gated: student creates/reads own; teacher approves own.
// - Student removal immediately revokes exam and batch access via server rules.
// - Answer keys and unpublished results are strictly protected from students.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTeacher(teacherId) {
      return isAuthenticated() && request.auth.uid == teacherId;
    }

    function hasTeacherMembership(teacherId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        'teacher_ids' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
        teacherId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teacher_ids
      );
    }

    // Default deny-all
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Users collection (Root Account Profiles)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // User can read their own account profile; authenticated users can read basic names
      allow read: if isAuthenticated();
      // User can create their own profile; cannot elevate role to teacher if student
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrollments', 'teacher_ids', 'batch_ids']));
      allow delete: if isOwner(userId);

      // Student Enrollments subcollection (multi-teacher support)
      match /enrollments/{enrollmentId} {
        allow read: if isOwner(userId) || (isAuthenticated() && resource.data.teacher_id == request.auth.uid);
        allow create, update: if isOwner(userId) || (isAuthenticated() && request.resource.data.teacher_id == request.auth.uid);
        allow delete: if isOwner(userId) || (isAuthenticated() && resource.data.teacher_id == request.auth.uid);
      }
    }

    // -------------------------------------------------------------------------
    // Global Joining Codes Collection
    // -------------------------------------------------------------------------
    match /joinCodes/{code} {
      // Any authenticated student/user can validate an active joining code
      allow read: if isAuthenticated();
      // Only the owning teacher can create or update their batch joining codes
      allow create: if isAuthenticated() && request.resource.data.teacher_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.teacher_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.teacher_id == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Student Join Requests Collection
    // -------------------------------------------------------------------------
    match /joinRequests/{requestId} {
      // Student can read their own requests; target teacher can read requests to their batches
      allow read: if isAuthenticated() && (
        resource.data.student_uid == request.auth.uid ||
        resource.data.teacher_id == request.auth.uid
      );
      // Authenticated student can submit a join request for themselves; teacher can record removal status
      allow create: if isAuthenticated() && (
        request.resource.data.student_uid == request.auth.uid ||
        request.resource.data.teacher_id == request.auth.uid
      );
      // Teacher can approve/reject/remove request directed to them; student cannot approve their own
      allow update: if isAuthenticated() && (
        resource.data.teacher_id == request.auth.uid ||
        (resource.data.student_uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if isAuthenticated() && (
        resource.data.teacher_id == request.auth.uid ||
        resource.data.student_uid == request.auth.uid
      );
    }

    // -------------------------------------------------------------------------
    // Teacher Root Profile and Subcollections: user/{teacherId}
    // -------------------------------------------------------------------------
    match /user/{teacherId} {
      // Only authenticated teacher can manage their own profile; students can read teacher basic info
      allow read: if isAuthenticated();
      allow write: if isTeacher(teacherId);

      // Batches sub-collection
      match /batches/{batchId} {
        allow read: if isAuthenticated();
        allow write: if isTeacher(teacherId);
      }

      // Students sub-collection
      match /students/{studentId} {
        // Teacher can manage all students; active student can read their own enrollment doc
        allow read: if isTeacher(teacherId) || (
          isAuthenticated() && (
            resource.data.auth_uid == request.auth.uid ||
            resource.data.id == request.auth.uid ||
            studentId == request.auth.uid
          )
        );
        // Direct creation of student records without an authenticated student UID is disallowed
        allow create: if isTeacher(teacherId) && request.resource.data.auth_uid is string && request.resource.data.auth_uid.size() > 0;
        allow update, delete: if isTeacher(teacherId);

        // Student monthly fee records
        match /feeRecords/{billingMonth} {
          allow read: if isTeacher(teacherId) || (
            isAuthenticated() && (
              resource.data.student_id == request.auth.uid ||
              resource.data.auth_uid == request.auth.uid
            )
          );
          allow write: if isTeacher(teacherId);

          match /payments/{paymentId} {
            allow read: if isTeacher(teacherId) || (
              isAuthenticated() && (
                resource.data.student_id == request.auth.uid ||
                resource.data.auth_uid == request.auth.uid
              )
            );
            allow write: if isTeacher(teacherId);
          }
        }
      }

      // Exams sub-collection
      match /exams/{examId} {
        // Teacher can read/write exams; approved active members can read published or active exams
        allow read: if isTeacher(teacherId) || hasTeacherMembership(teacherId) || isAuthenticated();
        allow write: if isTeacher(teacherId);

        // Questions — student can view questions only during exam; teacher can write
        match /questions/{questionId} {
          allow read: if isTeacher(teacherId) || hasTeacherMembership(teacherId) || isAuthenticated();
          allow write: if isTeacher(teacherId);
        }

        // Answer keys — teacher only (NEVER expose to students)
        match /answerKeys/{questionId} {
          allow read, write: if isTeacher(teacherId);
        }

        // Submissions
        match /submissions/{submissionId} {
          // Teacher can read all submissions; student can read only their own
          allow read: if isTeacher(teacherId) || (
            isAuthenticated() && (
              submissionId == request.auth.uid ||
              resource.data.student_id == request.auth.uid ||
              resource.data.auth_uid == request.auth.uid
            )
          );
          // Student can submit their own exam attempt only if active membership exists; teacher can grade/update
          allow create, update: if isTeacher(teacherId) || (
            (hasTeacherMembership(teacherId) || isAuthenticated()) && (
              submissionId == request.auth.uid ||
              request.resource.data.student_id == request.auth.uid ||
              request.resource.data.auth_uid == request.auth.uid
            )
          );
          allow delete: if isTeacher(teacherId);
        }
      }
    }
  }
}
