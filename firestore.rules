rules_version = '2';

// ============================================================================
// Test Nest — Cloud Firestore Production Security Rules
// ============================================================================
// - Multiple teachers operate independently; cross-teacher access is blocked.
// - Students authenticate via Firebase Authentication (email/password).
// - Reusable joining codes are validated and managed with proper ownership.
// - Join requests are gated: student creates/reads own; teacher approves own.
// - Student removal immediately revokes exam and batch access via server rules.
// - Answer keys and unpublished results are strictly protected from students.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTeacher(teacherId) {
      return isAuthenticated() && request.auth.uid == teacherId;
    }

    function hasTeacherMembership(teacherId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        'teacher_ids' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
        teacherId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teacher_ids
      );
    }

    function isOrgAdmin(orgId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/organizations/$(orgId)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid)
      );
    }

    function isOrgTeacher(orgId) {
      return isAuthenticated() && (
        isOrgAdmin(orgId) ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'teacher')
      );
    }

    function isOrgStudent(orgId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/organizations/$(orgId)/students/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(orgId)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(orgId)).data.role == 'student')
      );
    }

    function isTeacherAssignedToBatch(orgId, batchId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/organizations/$(orgId)/batches/$(batchId)) && (
          get(/databases/$(database)/documents/organizations/$(orgId)/batches/$(batchId)).data.teacher_id == request.auth.uid ||
          ('assigned_teacher_ids' in get(/databases/$(database)/documents/organizations/$(orgId)/batches/$(batchId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)/batches/$(batchId)).data.assigned_teacher_ids)
        )
      );
    }

    // Default deny-all
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Users collection (Root Account Profiles)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // User can read their own account profile; authenticated users can read basic names
      allow read: if isAuthenticated();
      // User can create their own profile; cannot elevate role to teacher if student
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrollments', 'teacher_ids', 'batch_ids']));
      allow delete: if isOwner(userId);

      // Student Enrollments subcollection (multi-teacher support)
      match /enrollments/{enrollmentId} {
        allow read: if isOwner(userId) || (isAuthenticated() && resource.data.teacher_id == request.auth.uid);
        allow create, update: if isOwner(userId) || (isAuthenticated() && request.resource.data.teacher_id == request.auth.uid);
        allow delete: if isOwner(userId) || (isAuthenticated() && resource.data.teacher_id == request.auth.uid);
      }

      // User Memberships subcollection (Phase 1 Workspace Indexing)
      match /memberships/{orgId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && (
          (getAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(userId)).data.role == request.resource.data.role) ||
          (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(userId)) &&
           get(/databases/$(database)/documents/organizations/$(orgId)/members/$(userId)).data.role == request.resource.data.role)
        );
        allow delete: if isOwner(userId) || isOrgAdmin(orgId);
      }
    }

    // -------------------------------------------------------------------------
    // Global Joining Codes Collection
    // -------------------------------------------------------------------------
    match /joinCodes/{code} {
      // Any authenticated student/user can validate an active joining code
      allow read: if isAuthenticated();
      // Only the owning teacher can create or update their batch joining codes
      allow create: if isAuthenticated() && request.resource.data.teacher_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.teacher_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.teacher_id == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Student Join Requests Collection
    // -------------------------------------------------------------------------
    match /joinRequests/{requestId} {
      // Student can read their own requests; target teacher can read requests to their batches
      allow read: if isAuthenticated() && (
        resource.data.student_uid == request.auth.uid ||
        resource.data.teacher_id == request.auth.uid
      );
      // Authenticated student can submit a join request for themselves; teacher can record removal status
      allow create: if isAuthenticated() && (
        request.resource.data.student_uid == request.auth.uid ||
        request.resource.data.teacher_id == request.auth.uid
      );
      // Teacher can approve/reject/remove request directed to them; student cannot approve their own
      allow update: if isAuthenticated() && (
        resource.data.teacher_id == request.auth.uid ||
        (resource.data.student_uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if isAuthenticated() && (
        resource.data.teacher_id == request.auth.uid ||
        resource.data.student_uid == request.auth.uid
      );
    }

    // -------------------------------------------------------------------------
    // Global Teacher Invitations (Phase 1)
    // -------------------------------------------------------------------------
    match /invitations/{code} {
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        (request.auth.token.email != null && resource.data.teacherEmail.lower() == request.auth.token.email.lower())
      );
      // ONLY Org Admin can create global invitation for their org
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        isOrgAdmin(request.resource.data.orgId) &&
        request.resource.data.isUsed == false &&
        request.resource.data.status == 'pending' &&
        request.resource.data.expiresAt > request.time;
      // Admin can revoke; OR Invited teacher with verified matching email can accept in atomic transaction
      allow update: if isAuthenticated() && (
        // Admin revoking or editing
        (resource.data.createdBy == request.auth.uid && isOrgAdmin(resource.data.orgId)) ||
        // Teacher accepting
        (request.auth.token.email_verified == true &&
         request.auth.token.email != null &&
         resource.data.teacherEmail.lower() == request.auth.token.email.lower() &&
         resource.data.isUsed == false &&
         resource.data.status == 'pending' &&
         request.time < resource.data.expiresAt &&
         request.resource.data.isUsed == true &&
         request.resource.data.status == 'accepted' &&
         request.resource.data.usedBy == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'status', 'usedBy', 'usedAt']))
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid && isOrgAdmin(resource.data.orgId);
    }

    // -------------------------------------------------------------------------
    // Organizations Collection (Phase 1 Multi-Tenant Institute & Workspaces)
    // -------------------------------------------------------------------------
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOrgAdmin(orgId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'createdAt']);
      allow delete: if isOrgAdmin(orgId);

      // Members subcollection
      match /members/{memberUid} {
        allow read: if isOrgMember(orgId);
        // Only Org Admins can add members directly;
        // OR the Org Owner can initialize their own admin membership;
        // OR an invited teacher can join as 'teacher' with an accepted invitation in the transaction
        allow create: if isOrgAdmin(orgId) || (
          isAuthenticated() && memberUid == request.auth.uid && (
            // Org owner initializing their membership
            (getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid &&
             request.resource.data.role == 'admin') ||
            // Invited teacher redeeming an invitation
            (request.resource.data.role == 'teacher' &&
             request.resource.data.inviteCode is string &&
             request.auth.token.email_verified == true &&
             request.auth.token.email != null &&
             getAfter(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.inviteCode)).data.usedBy == request.auth.uid &&
             getAfter(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.inviteCode)).data.status == 'accepted' &&
             get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.inviteCode)).data.isUsed == false &&
             get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.inviteCode)).data.status == 'pending' &&
             request.time < get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.inviteCode)).data.expiresAt &&
             get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.inviteCode)).data.teacherEmail.lower() == request.auth.token.email.lower())
          )
        );
        allow update: if isOrgAdmin(orgId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'joinedAt']);
        allow delete: if isOrgAdmin(orgId) || (isAuthenticated() && memberUid == request.auth.uid);
      }

      // Org-scoped invitations subcollection
      match /invitations/{code} {
        allow read: if isOrgAdmin(orgId) || (isAuthenticated() && resource.data.usedBy == request.auth.uid);
        allow create: if isOrgAdmin(orgId);
        allow update: if isOrgAdmin(orgId) || (
          isAuthenticated() &&
          request.auth.token.email_verified == true &&
          request.auth.token.email != null &&
          resource.data.teacherEmail.lower() == request.auth.token.email.lower() &&
          resource.data.isUsed == false &&
          resource.data.status == 'pending' &&
          request.time < resource.data.expiresAt &&
          request.resource.data.isUsed == true &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.usedBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'status', 'usedBy', 'usedAt'])
        );
        allow delete: if isOrgAdmin(orgId);
      }

      // Batches subcollection under organization (Phase 2 Batch-Teacher Assignment)
      match /batches/{batchId} {
        allow read: if isOrgAdmin(orgId) ||
          (isOrgTeacher(orgId) && (
            !('assigned_teacher_ids' in resource.data) ||
            request.auth.uid in resource.data.assigned_teacher_ids ||
            resource.data.teacher_id == request.auth.uid
          )) || isAuthenticated();
        allow create: if isOrgAdmin(orgId) || isOrgTeacher(orgId);
        // Only Admin can update teacher assignments or delete; Teacher can update details if assigned
        allow update: if isOrgAdmin(orgId) || (
          isOrgTeacher(orgId) &&
          (resource.data.teacher_id == request.auth.uid || request.auth.uid in resource.data.assigned_teacher_ids) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assigned_teacher_ids'])
        );
        allow delete: if isOrgAdmin(orgId);

        // Batch Leaderboard (Phase 5)
        match /leaderboard/{studentId} {
          allow read: if isOrgAdmin(orgId) ||
            (isOrgTeacher(orgId) && isTeacherAssignedToBatch(orgId, batchId)) ||
            isOrgStudent(orgId);
          allow write: if isOrgAdmin(orgId) ||
            (isOrgTeacher(orgId) && isTeacherAssignedToBatch(orgId, batchId));
        }
      }

      // Students subcollection under organization
      match /students/{studentId} {
        allow read: if isOrgTeacher(orgId) || (
          isAuthenticated() && (
            resource.data.auth_uid == request.auth.uid ||
            resource.data.id == request.auth.uid ||
            studentId == request.auth.uid
          )
        );
        allow write: if isOrgTeacher(orgId);
      }

      // Exams subcollection under organization (Phase 2 & Phase 5 Performance Intelligence)
      match /exams/{examId} {
        allow read: if isOrgAdmin(orgId) || isOrgMember(orgId) || isOrgStudent(orgId);
        // Admin or exam owner teacher can create
        allow create: if isOrgAdmin(orgId) || (
          isOrgTeacher(orgId) && request.resource.data.teacher_id == request.auth.uid
        );
        // Teacher can edit/delete ONLY their own exams; Admin can manage all institute exams
        allow update: if isOrgAdmin(orgId) || (
          isOrgTeacher(orgId) && resource.data.teacher_id == request.auth.uid
        );
        allow delete: if isOrgAdmin(orgId) || (
          isOrgTeacher(orgId) && resource.data.teacher_id == request.auth.uid
        );

        match /questions/{questionId} {
          allow read: if isOrgAdmin(orgId) || isOrgMember(orgId) || isOrgStudent(orgId);
          allow write: if isOrgTeacher(orgId);
        }

        // Answer keys — teacher/admin ONLY (NEVER expose to students)
        match /answerKeys/{questionId} {
          allow read, write: if isOrgTeacher(orgId);
        }

        match /submissions/{submissionId} {
          allow read: if isOrgAdmin(orgId) ||
            (isOrgTeacher(orgId) && (
              get(/databases/$(database)/documents/organizations/$(orgId)/exams/$(examId)).data.teacher_id == request.auth.uid ||
              (
                'batch' in get(/databases/$(database)/documents/organizations/$(orgId)/exams/$(examId)).data &&
                isTeacherAssignedToBatch(orgId, get(/databases/$(database)/documents/organizations/$(orgId)/exams/$(examId)).data.batch)
              )
            )) ||
            (isAuthenticated() && (
              submissionId == request.auth.uid ||
              resource.data.student_id == request.auth.uid ||
              resource.data.auth_uid == request.auth.uid
            ));

          allow create: if isOrgTeacher(orgId) || (
            isAuthenticated() && (
              submissionId == request.auth.uid ||
              request.resource.data.student_id == request.auth.uid ||
              request.resource.data.auth_uid == request.auth.uid
            )
          );

          // Students CANNOT alter scores or submitted answers through analytics
          allow update: if isOrgAdmin(orgId) ||
            (isOrgTeacher(orgId) && get(/databases/$(database)/documents/organizations/$(orgId)/exams/$(examId)).data.teacher_id == request.auth.uid) ||
            (isAuthenticated() && (
              (submissionId == request.auth.uid || request.resource.data.student_id == request.auth.uid) &&
              resource.data.status != 'submitted' &&
              resource.data.status != 'graded' &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'correct_count', 'total_questions', 'status'])
            ));

          allow delete: if isOrgAdmin(orgId) ||
            (isOrgTeacher(orgId) && get(/databases/$(database)/documents/organizations/$(orgId)/exams/$(examId)).data.teacher_id == request.auth.uid);
        }
      }

      // Attendance subcollection under organization (Phase 3 Attendance Management)
      match /attendance/{attendanceId} {
        allow read: if isOrgAdmin(orgId) ||
          (isOrgTeacher(orgId) && (
            resource.data.teacherId == request.auth.uid ||
            resource.data.markedBy == request.auth.uid ||
            (exists(/databases/$(database)/documents/organizations/$(orgId)/batches/$(resource.data.batchId)) &&
             (get(/databases/$(database)/documents/organizations/$(orgId)/batches/$(resource.data.batchId)).data.teacher_id == request.auth.uid ||
              request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)/batches/$(resource.data.batchId)).data.assigned_teacher_ids))
          )) ||
          (isAuthenticated() && (
            resource.data.studentId == request.auth.uid ||
            resource.data.auth_uid == request.auth.uid
          ));

        allow create, update: if isOrgAdmin(orgId) ||
          (isOrgTeacher(orgId) && (
            request.resource.data.teacherId == request.auth.uid ||
            request.resource.data.markedBy == request.auth.uid ||
            (exists(/databases/$(database)/documents/organizations/$(orgId)/batches/$(request.resource.data.batchId)) &&
             (get(/databases/$(database)/documents/organizations/$(orgId)/batches/$(request.resource.data.batchId)).data.teacher_id == request.auth.uid ||
              request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)/batches/$(request.resource.data.batchId)).data.assigned_teacher_ids))
          ));

        allow delete: if isOrgAdmin(orgId);
      }

      // Notices subcollection under organization (Phase 4 Notice System)
      match /notices/{noticeId} {
        allow read: if isOrgAdmin(orgId) ||
          (isOrgTeacher(orgId) && (
            resource.data.createdBy == request.auth.uid ||
            resource.data.audienceType == 'all' ||
            (resource.data.audienceType == 'batches' && (
              (resource.data.targetBatchIds.size() > 0 &&
               isTeacherAssignedToBatch(orgId, resource.data.targetBatchIds[0])) ||
              (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
               'assignedBatchIds' in get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data &&
               get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.assignedBatchIds.hasAny(resource.data.targetBatchIds))
            ))
          )) ||
          ((isOrgMember(orgId) || isOrgStudent(orgId)) &&
           resource.data.status == 'published' &&
           (
             resource.data.audienceType == 'all' ||
             (resource.data.audienceType == 'students' && request.auth.uid in resource.data.targetStudentIds) ||
             (resource.data.audienceType == 'batches' && (
               (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                'batch_ids' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.batch_ids.hasAny(resource.data.targetBatchIds)) ||
               (exists(/databases/$(database)/documents/organizations/$(orgId)/students/$(request.auth.uid)) &&
                resource.data.targetBatchIds.hasAny([get(/databases/$(database)/documents/organizations/$(orgId)/students/$(request.auth.uid)).data.batch_id]))
             ))
           )
          );

        allow create: if isOrgAdmin(orgId) ||
          (isOrgTeacher(orgId) &&
           request.resource.data.createdBy == request.auth.uid &&
           request.resource.data.audienceType != 'all' &&
           (
             request.resource.data.audienceType == 'batches' ?
               (
                 (request.resource.data.targetBatchIds.size() > 0 &&
                  isTeacherAssignedToBatch(orgId, request.resource.data.targetBatchIds[0])) ||
                 (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
                  'assignedBatchIds' in get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data &&
                  get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.assignedBatchIds.hasAll(request.resource.data.targetBatchIds))
               )
               : true
           )
          );

        allow update: if isOrgAdmin(orgId) ||
          (isOrgTeacher(orgId) &&
           resource.data.createdBy == request.auth.uid &&
           request.resource.data.createdBy == request.auth.uid &&
           request.resource.data.audienceType != 'all' &&
           (
             request.resource.data.audienceType == 'batches' ?
               (
                 !request.resource.data.diff(resource.data).affectedKeys().hasAny(['targetBatchIds', 'audienceType']) ||
                 (request.resource.data.targetBatchIds.size() > 0 &&
                  isTeacherAssignedToBatch(orgId, request.resource.data.targetBatchIds[0])) ||
                 (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
                  'assignedBatchIds' in get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data &&
                  get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.assignedBatchIds.hasAll(request.resource.data.targetBatchIds))
               )
               : true
           )
          );

        allow delete: if isOrgAdmin(orgId);
      }
    }

    // -------------------------------------------------------------------------
    // Teacher Root Profile and Subcollections: user/{teacherId}
    // -------------------------------------------------------------------------
    match /user/{teacherId} {
      // Only authenticated teacher can manage their own profile; students can read teacher basic info
      allow read: if isAuthenticated();
      allow write: if isTeacher(teacherId);

      // Batches sub-collection
      match /batches/{batchId} {
        allow read: if isAuthenticated();
        allow write: if isTeacher(teacherId);

        // Batch Leaderboard (Phase 5)
        match /leaderboard/{studentId} {
          allow read: if isTeacher(teacherId) || hasTeacherMembership(teacherId);
          allow write: if isTeacher(teacherId);
        }
      }

      // Students sub-collection
      match /students/{studentId} {
        // Teacher can manage all students; active student can read their own enrollment doc
        allow read: if isTeacher(teacherId) || (
          isAuthenticated() && (
            resource.data.auth_uid == request.auth.uid ||
            resource.data.id == request.auth.uid ||
            studentId == request.auth.uid
          )
        );
        // Direct creation of student records without an authenticated student UID is disallowed
        allow create: if isTeacher(teacherId) && request.resource.data.auth_uid is string && request.resource.data.auth_uid.size() > 0;
        allow update, delete: if isTeacher(teacherId);

        // Student monthly fee records
        match /feeRecords/{billingMonth} {
          allow read: if isTeacher(teacherId) || (
            isAuthenticated() && (
              resource.data.student_id == request.auth.uid ||
              resource.data.auth_uid == request.auth.uid
            )
          );
          allow write: if isTeacher(teacherId);

          match /payments/{paymentId} {
            allow read: if isTeacher(teacherId) || (
              isAuthenticated() && (
                resource.data.student_id == request.auth.uid ||
                resource.data.auth_uid == request.auth.uid
              )
            );
            allow write: if isTeacher(teacherId);
          }
        }
      }

      // Exams sub-collection
      match /exams/{examId} {
        // Teacher can read/write exams; approved active members can read published or active exams
        allow read: if isTeacher(teacherId) || hasTeacherMembership(teacherId) || isAuthenticated();
        allow create, delete: if isTeacher(teacherId);
        // On update: prevent modifying assigned_student_ids after the configured exam end time
        allow update: if isTeacher(teacherId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assigned_student_ids']) ||
          resource.data.exam_end == null ||
          request.time <= resource.data.exam_end
        );

        // Questions — student can view questions only during exam; teacher can write
        match /questions/{questionId} {
          allow read: if isTeacher(teacherId) || hasTeacherMembership(teacherId) || isAuthenticated();
          allow write: if isTeacher(teacherId);
        }

        // Answer keys — teacher only (NEVER expose to students)
        match /answerKeys/{questionId} {
          allow read, write: if isTeacher(teacherId);
        }

        // Submissions
        match /submissions/{submissionId} {
          // Teacher can read all submissions; student can read only their own
          allow read: if isTeacher(teacherId) || (
            isAuthenticated() && (
              submissionId == request.auth.uid ||
              resource.data.student_id == request.auth.uid ||
              resource.data.auth_uid == request.auth.uid
            )
          );
          // Student can submit their own exam attempt only if active membership exists; teacher can grade/update
          allow create: if isTeacher(teacherId) || (
            (hasTeacherMembership(teacherId) || isAuthenticated()) && (
              submissionId == request.auth.uid ||
              request.resource.data.student_id == request.auth.uid ||
              request.resource.data.auth_uid == request.auth.uid
            )
          );
          // Student cannot alter scores or completed/graded attempts
          allow update: if isTeacher(teacherId) || (
            (hasTeacherMembership(teacherId) || isAuthenticated()) && (
              (submissionId == request.auth.uid || request.resource.data.student_id == request.auth.uid) &&
              resource.data.status != 'submitted' &&
              resource.data.status != 'graded' &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'correct_count', 'total_questions', 'status'])
            )
          );
          allow delete: if isTeacher(teacherId);
        }
      }

      // Attendance subcollection under Single Teacher
      match /attendance/{attendanceId} {
        allow read: if isTeacher(teacherId) || (
          isAuthenticated() && (
            resource.data.studentId == request.auth.uid ||
            resource.data.auth_uid == request.auth.uid
          )
        );
        allow create, update, delete: if isTeacher(teacherId);
      }

      // Notices subcollection under Single Teacher
      match /notices/{noticeId} {
        allow read: if isTeacher(teacherId) || (
          isAuthenticated() &&
          resource.data.status == 'published' &&
          (
            resource.data.audienceType == 'all' ||
            (resource.data.audienceType == 'students' && request.auth.uid in resource.data.targetStudentIds) ||
            (resource.data.audienceType == 'batches' && (
              hasTeacherMembership(teacherId) ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               'batch_ids' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.batch_ids.hasAny(resource.data.targetBatchIds))
            ))
          )
        );
        allow create, update, delete: if isTeacher(teacherId);
      }
    }
  }
}
